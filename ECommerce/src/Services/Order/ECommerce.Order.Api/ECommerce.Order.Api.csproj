    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>56d89425-6ed0-43a6-b6d2-1e37d8e928b4</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
